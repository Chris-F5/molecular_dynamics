from collections import namedtuple
import numpy as np
import matplotlib.pyplot as plt
import unittest

PairList = namedtuple('PairList', 'pair_index pair_image pair_offset pair_distance')

class System:
  def __init__(self, particle_count, system_size):
    self.particle_count = particle_count
    self.system_size = system_size
    self.particle_position = np.random.random((particle_count, 3)) * system_size
    self.particle_charge = np.array([-1 if i % 2 else 1 for i in range(particle_count)])
  # Pair list includes duplicates
  def pair_list(self, image_distance):
    s = image_distance
    n = self.particle_count
    #pair_index,pair_image = np.array([ [[i,j],[x,y,z]] for i in range(n) for j in range(n) for x in range(-s, s+1) for y in range(-s, s+1) for z in range(-s, s+1) if not(x==0 and y==0 and z==0 and i==j)]).T
    pairs = np.array([[i,j,x,y,z] for i in range(n) for j in range(n) for x in range(-s, s+1) for y in range(-s, s+1) for z in range(-s, s+1) if not(x==0 and y==0 and z==0 and i==j)])
    pair_index,pair_image = pairs[:,0:2],pairs[:,2:5]
    pair_offset = self.particle_position[pair_index[:,0]] - (self.particle_position[pair_index[:,1]] + pair_image * self.system_size)
    pair_distance = np.linalg.norm(pair_offset, axis=1)
    return PairList(pair_index, pair_image, pair_offset, pair_distance)


def coulomb_poential_real_space(system, pair_list, cutoff_radius):
  pair_index = pair_list.pair_index
  pair_distance = pair_list.pair_distance
  pair_charge = system.particle_charge[pair_index[:,0]] * system.particle_charge[pair_index[:,1]]
  pair_potential = pair_charge / pair_distance

  potential = np.zeros(len(cutoff_radius))
  for i,radius in enumerate(cutoff_radius):
    potential[i] = np.sum(pair_potential[pair_distance < radius])
  return potential


class SystemTest(unittest.TestCase):
  def test_zero_charge(self):
    system = System(10, 1)
    self.assertEqual(np.sum(system.particle_charge), 0)
  def test_pair_count(self):
    for n in range(1, 5):
      for d in range(1, 3):
        system = System(n, 1)
        pairs = system.pair_list(d)
        self.assertEqual(pairs.pair_index.shape, (n*n*((d*2+1)**3)-n, 2))



if __name__ == "__main__":
  system = System(2, 1)
  cutoff_radii = np.linspace(0.1, 50, 100)
  pair_list = system.pair_list(int(np.max(cutoff_radii)//system.system_size)+1)
  potential = coulomb_poential_real_space(system, pair_list, cutoff_radii)

  plt.plot(cutoff_radii, potential)
  plt.legend()
  plt.show()
